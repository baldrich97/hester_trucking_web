{
  "name": "hester_trucking_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "echo 'cache bust 001' && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:pages": "playwright test tests/e2e/page-audit.spec.ts",
    "test:cleanup": "node scripts/cleanup-test-data.mjs",
    "seed:cutover": "node scripts/seed-cutover-dev.mjs",
    "test:timings": "node scripts/collect-test-timings.mjs record",
    "test:timings:check": "node scripts/collect-test-timings.mjs check",
    "test:all": "npm test && npm run test:db && npm run test:e2e",
    "postinstall": "prisma generate",
    "vercel-build": "npm run postinstall && next build"
  },
  "engines": {
    "node": "20.x"
  },
